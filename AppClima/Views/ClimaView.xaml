<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppClima.Views.ClimaView"
             Title="ClimaView">
    <VerticalStackLayout>
        <Image
            Source="dotnet_bot.png"
            WidthRequest="400"
            x:Name="CondicaoImage" />
        <Label x:Name="CondicaoLabel"
               Text="Chovendo Muito"/>
        <Label x:Name="CidadeLabel"
               Text="{Binding Cidade}"/>
        <HorizontalStackLayout>
            <Label Text="Minima"/>
            <Label Text="0"
                   x:Name="TemperaturaMinimaLabel"/>
            <Label Text="Maxima"/>
            <Label Text="99"
                   x:Name="TemperaturaMaximaLabel"/>


        </HorizontalStackLayout>
        
        <HorizontalStackLayout>
          
            
            
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>